# Copy this file to .env and replace only the API-key placeholder.
# Recommended large-document provider (OpenAI-compatible Lightning Model API).
# The base URL must stop before /chat/completions.
LLM_BASE_URL=https://lightning.ai/api/v1
LLM_API_KEY=replace-with-your-lightning-api-key
LLM_MODEL=openai/gpt-5.4-mini-2026-03-17
# The gateway accepts a small schema but rejects this project's nullable full
# schema, so use JSON Object Mode plus mandatory local validation.
LLM_SUPPORTS_JSON_SCHEMA=false

# Groq remains supported after request compaction. To use it instead, replace
# the three values above with the following and insert your Groq key:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=replace-with-your-groq-api-key
# LLM_MODEL=openai/gpt-oss-120b
# LLM_SUPPORTS_JSON_SCHEMA=true

# The trusted default uses a text-only LLM for semantic extraction.
# Source images stay local, but the OCR business text is sent to this endpoint.
OCR_BACKEND=paddle
OCR_LANGUAGES=en

# Local OCR uses CPU unless --gpu is passed on the command line. PaddleOCR uses
# the first configured language model; EasyOCR can consume a comma-separated list.
